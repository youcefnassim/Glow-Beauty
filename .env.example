# Glow Beauty Cosmetics - Environment Configuration
# Copy this file to .env and configure your Supabase project credentials

VITE_APP_NAME="Glow Beauty"
VITE_DEFAULT_CURRENCY="DZD"
VITE_CURRENCY_SYMBOL="DA"

# Supabase Credentials (leave empty or set to demo to use rich offline/mock store with LocalStorage persistence)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional payment providers (BaridiMob, Satim/CIB - set to true once merchant contracts are in place)
VITE_ENABLE_ONLINE_PAYMENTS="false"
VITE_FREE_DELIVERY_THRESHOLD="8000"
